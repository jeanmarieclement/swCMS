{
    "name": "swcms/swcms",
    "description": "A modern, modular Content Management System built with PHP and MVC architecture. Features user management, plugin system, theme support, and comprehensive admin interface.",
    "version": "1.0.0",
    "type": "project",
    "keywords": [
        "cms",
        "content-management",
        "php",
        "mvc",
        "smarty",
        "wordpress-alternative",
        "blog",
        "website",
        "admin-panel",
        "plugins",
        "themes"
    ],
    "homepage": "https://github.com/jeanmarieclement/swCMS",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/jeanmarieclement/swCMS/issues",
        "source": "https://github.com/jeanmarieclement/swCMS",
        "docs": "https://github.com/jeanmarieclement/swCMS/wiki"
    },
    "require": {
        "php": ">=7.4",
        "smarty/smarty": "^5.5",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "classmap": ["app/"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "cs-check": "phpcs --standard=PSR12 App/",
        "cs-fix": "phpcbf --standard=PSR12 App/",
        "migrate-up": "php database/migrate.php up",
        "migrate-down": "php database/migrate.php down"
    },
    "authors": [
        {
            "name": "swCMS Contributors",
            "homepage": "https://github.com/jeanmarieclement/swCMS/contributors"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
