# swCMS Environment Configuration
# Copy this file to .env and configure your environment settings

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database driver: mysql or sqlite
DB_DRIVER=mysql

# MySQL Configuration
DB_HOST=localhost
DB_NAME=swcms
DB_USER=swcms_user
DB_PASS=your_password_here
DB_CHARSET=utf8mb4
DB_PORT=3306

# SQLite Configuration (alternative to MySQL)
# Uncomment and set path if using SQLite
# DB_SQLITE_PATH=./data/database.sqlite

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Site Configuration
SITE_NAME="swCMS"
SITE_URL=http://localhost
SITE_DESCRIPTION="A modern CMS built with PHP"

# Debug and Development
DEBUG_MODE=true
LOG_LEVEL=debug

# Security
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
CSRF_TOKEN_EXPIRY=3600

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Settings (for notifications and contact forms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yoursite.com
MAIL_FROM_NAME="swCMS"

# =============================================================================
# MEDIA AND UPLOADS
# =============================================================================

# File Upload Settings
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,txt
UPLOAD_PATH=./public/uploads

# Image Processing
AUTO_RESIZE_IMAGES=true
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1080
THUMBNAIL_SIZE=150

# =============================================================================
# CACHE AND PERFORMANCE
# =============================================================================

# Template Cache
TEMPLATE_CACHE=true
TEMPLATE_CACHE_LIFETIME=3600

# Page Cache (Smarty full-page cache)
# Keep this off unless the theme templates wrap the CSRF token and the flash
# messages in {nocache}: a cached page otherwise serves whatever the first
# visitor saw, token included, to everyone else until it expires.
PAGE_CACHE=false
PAGE_CACHE_LIFETIME=1800
# One in N cached requests deletes expired cache files. Smarty stops serving an
# expired entry but never removes it, so without a sweep the directory only
# grows. Set to 0 to disable.
PAGE_CACHE_GC_PROBABILITY=100

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Google Analytics
GOOGLE_ANALYTICS_ID=

# reCAPTCHA (for forms)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Social Media
FACEBOOK_APP_ID=
TWITTER_API_KEY=

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Docker Configuration (for development)
DOCKER_DB_HOST=db
DOCKER_DB_PORT=3306
DOCKER_DB_ROOT_PASSWORD=root_password

# API Settings
API_ENABLED=false
API_VERSION=v1
API_RATE_LIMIT=100

# =============================================================================
# BACKUP SETTINGS
# =============================================================================

# Automatic Backup
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION=30
BACKUP_PATH=./backups

# =============================================================================
# PLUGIN SETTINGS
# =============================================================================

# Plugin Directory
PLUGINS_DIR=./plugins
AUTO_ACTIVATE_PLUGINS=false

# Theme Settings
THEMES_DIR=./public/themes
DEFAULT_THEME=default

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Password Requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_STRONG_PASSWORDS=true

# Login Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# File Security
DISABLE_FILE_EDITING=false
FORCE_SSL=false

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Log Files
ERROR_LOG=./logs/error.log
ACCESS_LOG=./logs/access.log
PLUGIN_LOG=./logs/plugins.log

# Monitoring
ENABLE_QUERY_LOGGING=false
ENABLE_PERFORMANCE_MONITORING=false